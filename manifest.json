{
  "manifest_version": 3,
  "name": "LNCT Attendance Helper",
  "version": "3.2.0",
  "description": "Private local attendance dashboard with refresh, profile and semester history for LNCT University and College.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "LNCT Attendance"
  },
  "options_page": "options.html",
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lnct-attendance-helper@yourdomain.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://lnctu.ac.in*",
        "https://lnctu.ac.in*",
        "https://lnct.ac.in*",
        "https://lnct.ac.in*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://lnctu.ac.in*",
        "https://lnctu.ac.in*",
        "https://lnct.ac.in*",
        "https://lnct.ac.in*",
        "https://lnct.ac.in*"
      ],
      "js": ["attendance_parser.js", "attendance_scraper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://lnctu.ac.in*",
        "https://lnctu.ac.in*",
        "https://lnct.ac.in*",
        "https://lnct.ac.in*"
      ],
      "js": ["attendance_parser.js", "profile_scraper.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://lnctu.ac.in*",
    "https://lnct.ac.in*"
  ]
}
