{
  "manifest_version": 3,
  "name": "LNCT Attendance Helper",
  "version": "3.0.0",
  "description": "Auto-login, live attendance %, subject graph & profile — for LNCT University & LNCT College.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "LNCT Attendance"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://accsoft.lnctu.ac.in/AccSoft2/StudentLogin.aspx*",
        "https://accsoft.lnctu.ac.in/AccSoft2/Student/StudentLogin.aspx*",
        "https://portal.lnct.ac.in/Accsoft2/studentLogin.aspx*",
        "https://portal.lnct.ac.in/Accsoft2/StudentLogin.aspx*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://accsoft.lnctu.ac.in/AccSoft2/Parents/StuAttendanceStatus.aspx*",
        "https://accsoft.lnctu.ac.in/AccSoft2/*StuAttendanceStatus*",
        "https://portal.lnct.ac.in/Accsoft2/Parents/StuAttendanceStatus.aspx*",
        "https://portal.lnct.ac.in/Accsoft2/*StuAttendanceStatus*",
        "https://portal.lnct.ac.in/Accsoft2/*ttendance*"
      ],
      "js": ["attendance_scraper.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://accsoft.lnctu.ac.in/*",
    "https://portal.lnct.ac.in/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/lnct_logo.png", "icons/lnct_popup_logo.png"],
      "matches": ["https://accsoft.lnctu.ac.in/*", "https://portal.lnct.ac.in/*"]
    }
  ]
}
